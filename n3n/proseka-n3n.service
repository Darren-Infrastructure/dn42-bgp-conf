[Unit]
Description=n3n edge process, for proseka
After=network-online.target nfw.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=
ExecStart=/usr/sbin/n3n-edge start proseka
ExecStartPost=sh /etc/n3n/proseka-ipv6-conf.sh
Restart=on-abnormal
RestartSec=5

[Install]
WantedBy=multi-user.target
